{
  "name": "pear-notes",
  "version": "1.1.0",
  "buildNumber": 1,
  "private": true,
  "main": "index.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start:clean": "watchman watch-del $PWD; watchman watch-project $PWD && expo start --dev-client --port 8099 --clear",
    "android": "RCT_METRO_PORT=8099 expo run:android --port 8099 --app-id com.amreshvs.pearnotes.dev",
    "android:release": "cd android && JAVA_HOME=$(/usr/libexec/java_home -v 21) ./gradlew assembleRelease",
    "android:release-dev": "cd android && JAVA_HOME=$(/usr/libexec/java_home -v 21) ./gradlew assembleReleaseDev",
    "android:bundle": "cd android && JAVA_HOME=$(/usr/libexec/java_home -v 21) ./gradlew bundleRelease",
    "ios": "RCT_METRO_PORT=8099 expo run:ios --port 8099",
    "ios:release": "expo run:ios --device --configuration Release",
    "pod": "cd ios && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 pod install",
    "bare-bundle": "node scripts/minify-core.js && npx bare-pack --host android-arm64 --host ios-arm64 --host ios-arm64-simulator --linked --out src/backend/backend.bundle.js .core-build/main.mjs",
    "harden-core": "node scripts/minify-core.js",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "kickstart": "node scripts/kickstart.js",
    "copy-core": "node scripts/copy-core.js && npm run bare-bundle",
    "build:editor": "cd editor-bundle && npm install && npm run build",
    "typecheck": "tsc --noEmit",
    "version:set": "node scripts/set-version.js",
    "preflight": "node scripts/preflight.js",
    "play-key": "node scripts/setup-play-key.js",
    "release:ios": "node scripts/release.js --platform ios",
    "release:android": "node scripts/release.js --platform android",
    "release:all": "node scripts/release.js --platform all",
    "creds:check": "node scripts/check-eas-credentials.js",
    "pin-core": "node scripts/pin-core.js",
    "native-addons": "node scripts/prepare-native-addons.mjs",
    "eas-build-pre-install": "node scripts/eas-build-hooks.mjs pre-install",
    "eas-build-post-install": "node scripts/eas-build-hooks.mjs post-install"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/ui": "~56.0.26",
    "@pchmn/expo-material3-theme": "^1.4.0",
    "@pear-notes/core": "github:AmreshVs/pear-notes-core#2cfc151ed5f61edb7fbc695a1d94914323d62e5f",
    "@qvac/sdk": "^0.19.1",
    "@react-native-community/slider": "^5.1.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-vector-icons/material-design-icons": "^13.1.2",
    "@reduxjs/toolkit": "2.12.0",
    "b4a": "1.8.0",
    "buffer": "^6.0.3",
    "date-fns": "^4.1.0",
    "expo": "~56.0.21",
    "expo-asset": "~56.0.17",
    "expo-audio": "~56.0.13",
    "expo-background-service": "file:modules/expo-background-service",
    "expo-background-task": "~56.0.27",
    "expo-blur": "~56.0.4",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.5",
    "expo-device": "~56.0.4",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.12",
    "expo-image-manipulator": "~56.0.26",
    "expo-image-picker": "~56.0.25",
    "expo-linking": "~56.0.17",
    "expo-local-authentication": "~56.0.5",
    "expo-localization": "~56.0.6",
    "expo-network": "^56.0.5",
    "expo-router": "~56.2.20",
    "expo-screen-capture": "~56.0.5",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.27",
    "expo-video": "~56.1.4",
    "expo-web-browser": "~56.0.6",
    "framed-stream": "^1.0.1",
    "hrpc": "^4.3.1",
    "i18next": "^26.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.2",
    "react-native": "0.85.3",
    "react-native-bare-kit": "^0.15.5",
    "react-native-document-scanner-plugin": "^2.0.4",
    "react-native-enriched": "^0.4.1",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-paper": "^5.15.3",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3",
    "react-redux": "9.3.0",
    "redux": "5.0.1",
    "redux-saga": "1.5.0",
    "which-runtime": "1.3.2"
  },
  "devDependencies": {
    "@react-native/typescript-config": "^0.84.0",
    "@swmansion/argent": "^0.22.0",
    "@types/react": "~19.2.10",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~56.0.0",
    "bare-pack": "^2.0.0",
    "eslint": "^8.57.0",
    "eslint-config-universe": "^12.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "javascript-obfuscator": "^5.7.0",
    "prettier": "^3.2.5",
    "react-refresh": "^0.18.0",
    "react-test-renderer": "19.1.0",
    "reactotron-react-native": "^5.3.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "expo-ui"
      ]
    }
  },
  "standard": {
    "globals": [
      "BareKit"
    ]
  }
}
