{
  "expo": {
    "name": "Pear notes",
    "slug": "pear-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pearnotes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amreshvs.pearnotes",
      "appleTeamId": "65S93235JA",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Pear Notes to access your microphone to record voice notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amreshvs.pearnotes",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pear Notes to use the camera to scan QR codes and documents."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Allow Pear Notes to use the camera to scan documents."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Pear Notes to access your microphone to record voice notes."
        }
      ],
      "expo-localization",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
