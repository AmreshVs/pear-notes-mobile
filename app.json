{
  "expo": {
    "name": "Pear notes",
    "slug": "pear-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pearnotes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amreshvs.pearnotes",
      "appleTeamId": "65S93235JA",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Pear Notes to access your microphone to record voice notes."
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.amreshvs.pearnotes",
      "allowBackup": false,
      "permissions": ["RECORD_AUDIO", "CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pear Notes to use the camera to scan QR codes and documents."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Allow Pear Notes to use the camera to scan documents."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Pear Notes to access your microphone to record voice notes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f2f2f7",
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#202020",
            "image": "./assets/images/icon.png"
          }
        }
      ],
      "expo-localization",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
