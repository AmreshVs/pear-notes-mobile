{
  "expo": {
    "name": "Pear Notes",
    "slug": "pear-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pearnotes",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.amreshvs.pear-notes",
      "appleTeamId": "DRQUZF86A2",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Pear Notes to access your microphone to record voice notes.",
        "NSCameraUsageDescription": "Allow Pear Notes to use the camera to take photos and videos for your notes.",
        "NSPhotoLibraryUsageDescription": "Allow Pear Notes to access your photo library so you can attach images and videos to your notes.",
        "NSPhotoLibraryAddUsageDescription": "Allow Pear Notes to save images to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "20"
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.amreshvs.pearnotes",
      "allowBackup": false,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "versionCode": 20
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-system-ui",
      "expo-image",
      "expo-task-manager",
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pear Notes to use the camera to scan QR codes and documents."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Allow Pear Notes to use the camera to scan documents."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Pear Notes to access your microphone to record voice notes.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f2f2f7",
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#090909",
            "image": "./assets/images/icon.png"
          }
        }
      ],
      "expo-localization",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Pear Notes to use Face ID to unlock locked notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71499373-83a5-493b-838f-0279921208c3"
      }
    },
    "owner": "vsamresh"
  }
}
